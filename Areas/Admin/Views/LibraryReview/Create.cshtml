
@model LibraryHub.Models.tblLibraryReview

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Thêm đánh giá thư viện";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Thêm đánh giá thư viện</h2>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="LibraryReview" asp-action="Index">Đánh giá thư viện</a>
                </li>
                <li class="breadcrumb-item active">Thêm đánh giá</li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid shadow-sm p-4 bg-white rounded">
        <form method="post"
              asp-area="Admin"
              asp-controller="LibraryReview"
              asp-action="Create"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="form-group col-md-6 mb-4">
                    <label class="form-label">Ảnh đại diện</label>

                    <div class="mb-3">
                        <img id="imagePreview"
                             src=""
                             alt="Xem trước ảnh đại diện"
                             style="width:110px;height:110px;object-fit:cover;border-radius:50%;border:1px solid #ddd;display:none;" />

                        <div id="noImageText"
                             class="d-flex justify-content-center align-items-center bg-light rounded-circle"
                             style="width:110px;height:110px;">
                            <i class="bi bi-person-fill text-secondary" style="font-size:45px;"></i>
                        </div>
                    </div>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.gif,.webp,image/*" />

                    <small class="text-muted">
                        Định dạng JPG, JPEG, PNG, GIF, WEBP. Dung lượng tối đa 5MB.
                    </small>

                    <span asp-validation-for="Avatar" class="text-danger d-block"></span>
                </div>

                <div class="form-group col-md-6 mb-4">
                    <label asp-for="FullName" class="form-label">Họ và tên người đánh giá</label>
                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="Nhập họ và tên..." />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6 mb-4">
                    <label asp-for="ReviewerTitle" class="form-label">Chức danh / Vai trò</label>
                    <input asp-for="ReviewerTitle"
                           class="form-control"
                           placeholder="Ví dụ: Độc giả, Thành viên câu lạc bộ sách..." />
                    <span asp-validation-for="ReviewerTitle" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6 mb-4">
                    <label asp-for="Rating" class="form-label">Mức độ đánh giá</label>
                    <select asp-for="Rating" class="form-select">
                        <option value="5">5 sao - Rất hài lòng</option>
                        <option value="4">4 sao - Hài lòng</option>
                        <option value="3">3 sao - Bình thường</option>
                        <option value="2">2 sao - Chưa hài lòng</option>
                        <option value="1">1 sao - Không hài lòng</option>
                    </select>
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>

                <div class="form-group col-12 mb-4">
                    <label asp-for="ReviewContent" class="form-label">Nội dung đánh giá</label>
                    <textarea asp-for="ReviewContent"
                              class="form-control"
                              rows="5"
                              placeholder="Nhập nội dung đánh giá về thư viện..."></textarea>
                    <span asp-validation-for="ReviewContent" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6 mb-4">
                    <label class="form-label">Trạng thái hiển thị</label>
                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">
                            Cho phép hiển thị khi đánh giá được duyệt
                        </label>
                    </div>
                </div>

                <div class="col-12 mb-3">
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Đánh giá mới sẽ ở trạng thái <strong>Chờ duyệt</strong>.
                        Bạn cần duyệt đánh giá tại danh sách quản lý trước khi đánh giá xuất hiện trên website.
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-area="Admin"
                   asp-controller="LibraryReview"
                   asp-action="Index"
                   class="btn btn-warning">
                    <i class="bi bi-arrow-left-circle"></i> Quay lại
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Lưu đánh giá
                </button>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const imageFile = document.getElementById('imageFile');
            const imagePreview = document.getElementById('imagePreview');
            const noImageText = document.getElementById('noImageText');

            imageFile.addEventListener('change', function () {
                const file = this.files && this.files[0];

                if (!file) {
                    imagePreview.src = '';
                    imagePreview.style.display = 'none';
                    noImageText.style.display = 'flex';
                    return;
                }

                if (!file.type.startsWith('image/')) {
                    alert('Vui lòng chọn một tệp hình ảnh hợp lệ.');
                    this.value = '';
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    alert('Dung lượng ảnh không được vượt quá 5MB.');
                    this.value = '';
                    return;
                }

                const reader = new FileReader();

                reader.onload = function (e) {
                    imagePreview.src = e.target.result;
                    imagePreview.style.display = 'block';
                    noImageText.style.display = 'none';
                };

                reader.readAsDataURL(file);
            });
        });
    </script>
}
