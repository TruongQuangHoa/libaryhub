@model LibraryHub.Models.tblBorrowingDetail
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Thêm mới chi tiết phiếu mượn</h2>
    </div>
    <!-- Hiển thị thông báo lỗi -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-octagon me-1"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="container shadow p-5">
        <form method="post" asp-action="Create">
            <div class="form-row">
                <div class="form-group col-md-6 mb-3">
                    <label>Phiếu mượn</label>
                    <select asp-for="BorrowingID" class="form-control"
                            asp-items="@(ViewBag.BorrowingList != null ? new SelectList(ViewBag.BorrowingList, "Value", "Text") : new SelectList(new List<object>()))"
                            required>
                        <option value="">--- Chọn phiếu mượn ---</option>
                    </select>
                    <span class="text-danger">
                        @ViewBag.BorrowingError
                    </span>
                    <span asp-validation-for="BorrowingID" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6 mb-3">
                    <label>Sách</label>
                    <select asp-for="BookID" class="form-control"
                            asp-items="@(new SelectList(ViewBag.bookList, "Value", "Text"))" required>
                        <option value="">--- Chọn sách ---</option>
                    </select>
                    <span class="text-danger">
                        @ViewBag.BookError
                    </span>
                    <span asp-validation-for="BookID" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label>Phí mượn sách</label>
                    <input type="number" step="1000" min="0" class="form-control" asp-for="BorrowingFee"
                           placeholder="Phí mượn sách" required />
                    <span asp-validation-for="BorrowingFee" class="text-danger"></span>
                    <small class="text-muted">Chỉ nhập số nguyên ≥ 0 (Ví dụ: Nhập 6000 tương đương 6.000 VNĐ)</small>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label>
                        @Html.CheckBox("IsActive", false)
                        Hiển thị
                    </label>
                </div>
            </div>

            <a asp-controller="BorrowingDetail" asp-action="Index" class="btn btn-lg btn-warning p-2">
                <i class="bi bi-arrow-left-circle"></i> Quay lại
            </a>

            <button type="submit" class="btn btn-lg btn-primary p-2">
                <i class="bi bi-file-plus-fill"></i> Lưu thông tin
            </button>
        </form>
    </div>
</main>