@model LibraryHub.Models.tblBorrowingDetail
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<main id="main" class="main">
    <div class="pagetitle">
        <h2>Sửa chi tiết phiếu mượn</h2>
    </div>

    <div class="container shadow p-5">
        <form method="post" asp-action="Edit">
            <div class="form-row">
                <input type="hidden" asp-for="BorrowingDetailID" />

                <!-- Không cho sửa Phiếu mượn, hiển thị thông tin readonly -->
                <div class="form-group col-md-6 mb-3">
                    <label>Phiếu mượn</label>
                    <input type="hidden" asp-for="BorrowingID" />
                    <input type="text" class="form-control"
                           value="@Model.BorrowingID - @(Model.borrowing?.patron?.PatronName ?? "Độc giả không xác định") "
                           readonly />
                    <span class="text-danger">
                        @ViewBag.BorrowingError
                    </span>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label>Sách</label>
                    <select asp-for="BookID" class="form-select" asp-items="ViewBag.bookList">
                        <option value="">-- Chọn sách --</option>
                    </select>
                    <span class="text-danger">
                        @ViewBag.BookError
                    </span>
                    <span asp-validation-for="BookID" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label>Phí mượn sách</label>
                    <input type="number" step="1000" min="0" class="form-control" asp-for="BorrowingFee"
                           value="@Model.BorrowingFee.ToString("F0")" placeholder="Phí mượn sách" required />
                    <span asp-validation-for="BorrowingFee" class="text-danger"></span>
                    <small class="text-muted">Chỉ nhập số nguyên ≥ 0 (Ví dụ: Nhập 6000 tương đương 6.000 VNĐ)</small>
                </div>

                <!-- Hiển thị -->
                <div class="col-md-6 mb-3">
                    <div class="form-check">
                        @Html.CheckBox("IsActive", Model.IsActive, new { @class = "form-check-input", id = "IsActive" })
                        <label class="form-check-label" for="IsActive">Hiển thị</label>
                    </div>
                </div>
            </div>

            <a asp-controller="BorrowingDetail" asp-action="Index" class="btn btn-lg btn-warning p-2">
                <i class="bi bi-arrow-left-circle"></i> Quay lại
            </a>

            <button type="submit" class="btn btn-lg btn-primary p-2">
                <i class="bi bi-save"></i> Lưu thông tin
            </button>
        </form>
    </div>

</main>