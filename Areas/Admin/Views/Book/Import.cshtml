```cshtml
@{
    ViewData["Title"] = "Nhập sách từ Excel";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Nhập danh sách sách từ Excel</h2>
        <p class="text-muted">
            Tải file Excel chứa thông tin sách để nhập nhiều đầu sách cùng lúc.
        </p>
    </div>

    <section class="section">
        <div class="card">
            <div class="card-body mt-4">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                @if (ViewBag.Errors != null)
                {
                    <div class="alert alert-warning">
                        <strong>Chi tiết lỗi dữ liệu:</strong>
                        <ul class="mb-0 mt-2">
                            @foreach (var error in ViewBag.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-area="Admin"
                      asp-controller="Book"
                      asp-action="Import"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="excelFile" class="form-label">
                            Chọn file Excel (.xlsx)
                        </label>

                        <input type="file"
                               id="excelFile"
                               name="excelFile"
                               class="form-control"
                               accept=".xlsx"
                               required />

                        <small class="text-muted">
                            Dung lượng tối đa 10 MB.
                        </small>
                    </div>

                    <div class="alert alert-info">
                        <strong>Lưu ý:</strong>
                        <ul class="mb-0 mt-2">
                            <li>Dòng đầu tiên phải chứa tên các cột.</li>
                            <li>Các cột bắt buộc gồm:
                                TitleBook, Publisher, Author,
                                PublicationYear, CategoryID và BookQuantity.
                            </li>
                            <li>CategoryID phải khớp với mã thể loại
                                đang hoạt động trong hệ thống.</li>
                            <li>Nếu có lỗi dữ liệu, hệ thống sẽ không lưu
                                bất kỳ dòng sách nào.</li>
                        </ul>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-file-earmark-arrow-up"></i>
                        Nhập dữ liệu
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Book"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Quay lại
                    </a>
                </form>

            </div>
        </div>
    </section>
</main>
```