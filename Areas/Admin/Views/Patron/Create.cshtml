@model LibraryHub.Models.tblPatron

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">

    <div class="pagetitle">
        <h2>Thêm độc giả mới</h2>
    </div>

    <div class="container shadow p-5">

        <form method="post" asp-action="Create" enctype="multipart/form-data">

            <div class="form-row">
                <!-- ================================================= -->
                <!-- ẢNH ĐỘC GIẢ -->
                <!-- ================================================= -->
                <div class="form-group col-md-6 mb-3">

                    <label class="form-label">
                        Ảnh độc giả
                    </label>

                    <input type="file" name="photo" id="photo" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp">

                    <small class="text-muted">
                        Định dạng JPG, JPEG, PNG, GIF, WEBP.
                        Dung lượng tối đa 5MB.
                    </small>

                    <div class="mt-3">

                        <img id="previewImage" src="#" alt="Ảnh xem trước" style="
                        display:none;
                        width:190px;
                        height:190px;
                        object-fit:cover;
                        border-radius:10px;
                        border:1px solid #ddd;
                        ">

                    </div>

                    <span class="text-danger">
                        @Html.ValidationMessage("Photo")
                    </span>

                </div>

                <!-- TÊN -->
                <div class="form-group col-md-6 mb-3">
                    <label>Tên độc giả</label>

                    <input type="text" class="form-control" asp-for="PatronName" placeholder="Tên độc giả..." required>

                    <span asp-validation-for="PatronName" class="text-danger">
                    </span>
                </div>


                <!-- ĐỊA CHỈ -->
                <div class="form-group col-md-6 mb-3">
                    <label>Địa chỉ</label>

                    <input type="text" class="form-control" asp-for="Address" placeholder="Địa chỉ..." required>

                    <span asp-validation-for="Address" class="text-danger">
                    </span>
                </div>


                <!-- SỐ ĐIỆN THOẠI -->
                <div class="form-group col-md-6 mb-3">
                    <label>Số điện thoại</label>

                    <input type="text" class="form-control" asp-for="Phone" placeholder="Số điện thoại..." required>

                    <span asp-validation-for="Phone" class="text-danger">
                    </span>
                </div>


                <!-- EMAIL -->
                <div class="form-group col-md-6 mb-3">
                    <label asp-for="Email">Email</label>

                    <input type="email" class="form-control" asp-for="Email" placeholder="Nhập email..." required />

                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>



                <!-- NGÀY ĐĂNG KÝ -->
                <div class="form-group col-md-6 mb-3">
                    <label>Ngày đăng ký</label>

                    <input type="date" class="form-control" asp-for="RegisterDate" required>

                    <span asp-validation-for="RegisterDate" class="text-danger">
                    </span>
                </div>


                <!-- TRẠNG THÁI -->
                <div class="form-group col-md-6 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive">

                        <label class="form-check-label" asp-for="IsActive">
                            Hiển thị
                        </label>
                    </div>

                </div>

            </div>


            <!-- BUTTON -->
            <a asp-controller="Patron" asp-action="Index" class="btn btn-lg btn-warning p-2">

                <i class="bi bi-arrow-left-circle"></i>
                Quay lại

            </a>

            <button type="submit" class="btn btn-lg btn-primary p-2">

                <i class="bi bi-file-plus-fill"></i>
                Lưu thông tin

            </button>

        </form>

    </div>

</main>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.getElementById("photo")
            .addEventListener("change", function (event) {

                const file = event.target.files[0];

                const preview =
                    document.getElementById("previewImage");

                if (file) {

                    preview.src =
                        URL.createObjectURL(file);

                    preview.style.display = "block";

                } else {

                    preview.src = "#";
                    preview.style.display = "none";

                }

            });

    </script>
}