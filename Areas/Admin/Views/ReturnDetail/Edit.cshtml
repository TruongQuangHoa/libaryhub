@model LibraryHub.Models.tblReturnDetail

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chỉnh sửa Chi Tiết Sách Trả";
    var returnId = Model.ReturnID;
}

<main id="main" class="main">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Chỉnh sửa Chi Tiết Sách Trả</h5>

            <form asp-action="Edit" method="post">
                <div class="form-group mb-3">
                    <label class="form-label">Phiếu Trả</label>
                    <input class="form-control" 
                           value="Phiếu trả #@Model.ReturnID - Mượn gốc: #@Model._return?.BorrowingID - @Model._return?.borrowing?.patron?.PatronName" 
                           readonly />
                    <input type="hidden" name="ReturnID" value="@returnId" />
                    <input type="hidden" name="details[0].ReturnDetailID" value="@Model.ReturnDetailID" />
                    <input type="hidden" name="details[0].BookID" value="@Model.BookID" />
                    <input type="hidden" name="details[0].ReturnID" value="@Model.ReturnID" />
                </div>

                <hr />

                <h5 class="mt-3">Thông tin sách trả</h5>
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th width="35%">Tên sách</th>
                            <th width="15%" class="text-center">Hỏng/Mất?</th>
                            <th width="15%">Số ngày quá hạn</th>
                            <th width="15%">Phí quá hạn (VNĐ)</th>
                            <th width="20%">Phí hỏng/mất (VNĐ)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@Model.book?.TitleBook</td>
                            <td class="text-center">
                                <input type="checkbox" 
                                       class="form-check-input chk-damaged" 
                                       @(Model.IsDamaged ? "checked" : "") />
                                <input type="hidden" 
                                       name="details[0].IsDamaged" 
                                       id="hdnDamaged_0" 
                                       value="@Model.IsDamaged.ToString().ToLower()" />
                            </td>
                            <td class="text-center">
                                <input type="text" class="form-control" value="@Model.OverdueDays" readonly />
                                <input type="hidden" name="details[0].OverdueDays" value="@Model.OverdueDays" />
                            </td>
                            <td>
                                <input type="number" class="form-control" value="@Model.OverdueFine" readonly />
                                <input type="hidden" name="details[0].OverdueFine" value="@Model.OverdueFine" />
                            </td>
                            <td>
                                <input type="number" 
                                       name="details[0].LostFine" 
                                       class="form-control lost-fine" 
                                       value="@(Model.IsDamaged ? Model.LostFine : 0)" 
                                       min="0" 
                                       @(Model.IsDamaged ? "" : "readonly") />
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="mt-4">
                    <a asp-action="Index" class="btn btn-lg btn-warning p-2">
                        <i class="bi bi-arrow-left-circle"></i> Quay lại
                    </a>

                    <button type="submit" class="btn btn-lg btn-success p-2">
                        <i class="bi bi-check2"></i> Cập nhật thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.chk-damaged').change(function () {
                var $lostFineInput = $('.lost-fine');
                var $hiddenInput = $('#hdnDamaged_0');

                if ($(this).is(':checked')) {
                    $lostFineInput.removeAttr('readonly').val(100000);
                    $hiddenInput.val('true');
                } else {
                    $lostFineInput.attr('readonly', 'readonly').val(0);
                    $hiddenInput.val('false');
                }
            });
        });
    </script>
}