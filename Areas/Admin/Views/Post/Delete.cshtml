
@using LibraryHub.Models
@model tblPost

@{
    ViewData["Title"] = "Xóa bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}


<main id="main" class="main">
<div class="pagetitle">
    <h1>Xóa bài viết</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">Quản trị</li>
            <li class="breadcrumb-item">
                <a asp-action="Index">Quản lý bài viết</a>
            </li>
            <li class="breadcrumb-item active">Xóa bài viết</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="card">
        <div class="card-body">

            <div class="alert alert-warning mt-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Bạn có chắc chắn muốn xóa bài viết này không?
                Thao tác này không thể hoàn tác.
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Thumbnail))
                    {
                        <img src="@Model.Thumbnail"
                             class="img-fluid rounded"
                             alt="@Model.Title" />
                    }
                    else
                    {
                        <div class="bg-light rounded p-5 text-center">
                            <i class="bi bi-image fs-1 text-muted"></i>
                        </div>
                    }
                </div>

                <div class="col-md-8">
                    <h4>@Model.Title</h4>

                    <p class="text-muted">
                        @Model.Summary
                    </p>

                    <p>
                        <strong>Tác giả:</strong>
                        @(Model.AuthorName ?? "Chưa cập nhật")
                    </p>

                    <p>
                        <strong>Danh mục:</strong>
                        @(Model.Category ?? "Chưa phân loại")
                    </p>

                    <p>
                        <strong>Slug:</strong>
                        @Model.Slug
                    </p>

                    <p>
                        <strong>Ngày tạo:</strong>
                        @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>
            </div>

            <form asp-area="Admin"
                  asp-controller="Post"
                  asp-action="DeleteConfirmed"
                  method="post"
                  class="mt-4">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.PostID" />

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Hủy
                </a>

                <button type="submit"
                        class="btn btn-danger"
                        onclick="return confirm('Bạn chắc chắn muốn xóa bài viết này?');">
                    <i class="bi bi-trash"></i>
                    Xác nhận xóa
                </button>
            </form>

        </div>
    </div>
</section>
</main>
