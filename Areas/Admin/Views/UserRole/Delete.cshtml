@model LibraryHub.Models.tblUsersRoles
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h1 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Xác nhận xóa vai trò người dùng</h1>
    </div>
    <div class="container bg-light p-5 shadow-lg rounded">
        <p class="lead text-dark">Bạn có chắc chắn muốn xóa vai trò người dùng này?</p>

        <div class="row">
            <div class="mb-3 col-md-6">
                <label class="form-label font-weight-bold">Mã người dùng</label>
                <input type="text" class="form-control" value="@Model.UserID" disabled />
            </div>
            <div class="mb-3 col-md-6">
                <label class="form-label font-weight-bold">Tên người dùng</label>
                <input type="text" class="form-control" value="@Model.User?.UserName" disabled />
            </div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-6">
                <label class="form-label font-weight-bold">Mã vai trò</label>
                <input type="text" class="form-control" value="@Model.RoleID" disabled />
            </div>
            <div class="mb-3 col-md-6">
                <label class="form-label font-weight-bold">Tên vai trò</label>
                <input type="text" class="form-control" value="@Model.Role?.RoleName" disabled />
            </div>
        </div>

        <form asp-action="Delete" method="post" class="mt-4">
            @* Gửi 2 giá trị khóa chính để Controller thực hiện xóa *@
            <input type="hidden" name="userID" value="@Model.UserID" />
            <input type="hidden" name="roleID" value="@Model.RoleID" />

            @Html.AntiForgeryToken()

            <a class="btn btn-lg btn-secondary" asp-action="Index">
                <i class="bi bi-arrow-left-circle"></i>Quay lại
            </a>
            <button type="submit" class="btn btn-lg btn-danger">
                <i class="bi bi-trash"></i> Xác nhận xóa
            </button>
        </form>
    </div>
</main>