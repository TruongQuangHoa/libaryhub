@{
    ViewData["Title"] = "Liên hệ";
}

<!-- HERO SECTION -->
<section class="contact-hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="hero-badge">
                    <i class="bi bi-chat-dots-fill"></i>
                    Hỗ trợ & Tư vấn
                </span>

                <h1>
                    Chúng tôi luôn sẵn sàng
                    <span>lắng nghe bạn</span>
                </h1>

                <p class="hero-description">
                    Nếu bạn có bất kỳ thắc mắc nào về việc tìm kiếm, mượn trả sách
                    hoặc sử dụng các dịch vụ của LibraryHub, hãy liên hệ với chúng tôi.
                    Đội ngũ hỗ trợ luôn sẵn sàng đồng hành cùng bạn trên hành trình
                    khám phá tri thức.
                </p>

                <div class="hero-buttons">

                    <a href="#contactForm" class="btn btn-light btn-lg">
                        <i class="bi bi-send"></i>
                        Gửi liên hệ
                    </a>

                    <a href="tel:+84123456789" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-telephone"></i>
                        Gọi ngay
                    </a>

                </div>

            </div>

            <div class="col-lg-5">

                <div class="hero-card">

                    <div class="hero-stat">
                        <h3>24/7</h3>
                        <p>Hỗ trợ trực tuyến</p>
                    </div>

                    <div class="hero-stat">
                        <h3>5.000+</h3>
                        <p>Đầu sách</p>
                    </div>

                    <div class="hero-stat">
                        <h3>2.000+</h3>
                        <p>Độc giả</p>
                    </div>

                    <div class="hero-stat">
                        <h3>99%</h3>
                        <p>Phản hồi đúng hạn</p>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- CONTACT SECTION -->
<section class="contact-section">

    <div class="container">

        <div class="row g-4">

            <!-- CONTACT INFO -->
            <div class="col-lg-4">

                <div class="contact-info">

                    <h3 class="mb-4">Thông tin liên hệ</h3>

                    <div class="info-item">

                        <i class="bi bi-geo-alt-fill"></i>

                        <div>
                            <h6>Địa chỉ</h6>
                            <p>
                                182 Lê Lợi<br />
                                Phường Trường Vinh<br />
                                Nghệ An, Việt Nam
                            </p>
                        </div>

                    </div>

                    <div class="info-item">

                        <i class="bi bi-telephone-fill"></i>

                        <div>
                            <h6>Điện thoại</h6>
                            <p>+84 123 456 789</p>
                        </div>

                    </div>

                    <div class="info-item">

                        <i class="bi bi-envelope-fill"></i>

                        <div>
                            <h6>Email</h6>
                            <p>support@libraryhub.vn</p>
                        </div>

                    </div>

                    <div class="info-item">

                        <i class="bi bi-clock-fill"></i>

                        <div>
                            <h6>Giờ làm việc</h6>
                            <p>Thứ 2 - Thứ 6: 07:30 - 17:30</p>
                        </div>

                    </div>

                </div>

            </div>

            <!-- FORM -->
            <div class="col-lg-8">

                <div class="contact-form" id="contactForm">

                    <h3 class="mb-4">
                        Gửi tin nhắn cho chúng tôi
                    </h3>

                    <form>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    Họ và tên
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Nhập họ và tên">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    Email
                                </label>

                                <input type="email"
                                       class="form-control"
                                       placeholder="Nhập email">
                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Tiêu đề
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Nhập tiêu đề">

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Nội dung
                            </label>

                            <textarea rows="6"
                                      class="form-control"
                                      placeholder="Nhập nội dung cần gửi"></textarea>

                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg">

                            <i class="bi bi-send"></i>
                            Gửi liên hệ

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- WORKING TIME -->
<section class="working-time">

    <div class="container">

        <div class="text-center mb-5">

            <h2>Giờ hoạt động</h2>

            <p>
                Chúng tôi luôn sẵn sàng phục vụ bạn
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="time-card">

                    <i class="bi bi-calendar-week"></i>

                    <h5>Thứ 2 - Thứ 6</h5>

                    <p>07:30 - 17:30</p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="time-card">

                    <i class="bi bi-calendar-event"></i>

                    <h5>Thứ 7</h5>

                    <p>08:00 - 12:00</p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="time-card">

                    <i class="bi bi-calendar-x"></i>

                    <h5>Chủ nhật</h5>

                    <p>Nghỉ</p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- MAP -->
<section class="map-section">

    <div class="container">

        <div class="text-center mb-4">

            <h2>Vị trí thư viện</h2>

            <p>
                Tìm đường đến LibraryHub một cách dễ dàng
            </p>

        </div>

        <div class="map-container">

            <iframe
                src="https://maps.google.com/maps?q=vinh%20university&t=&z=15&ie=UTF8&iwloc=&output=embed"
                loading="lazy"
                allowfullscreen>
            </iframe>

        </div>

    </div>

</section>



<style>

.contact-hero{
    background: linear-gradient(
        135deg,
        #0d6efd 0%,
        #4f9cff 50%,
        #6aa8ff 100%
    );
    color:#fff;
    padding:120px 0;
    position:relative;
    overflow:hidden;
}

.contact-hero::before{
    content:'';
    position:absolute;
    width:500px;
    height:500px;
    border-radius:50%;
    background:rgba(255,255,255,.08);
    top:-200px;
    right:-150px;
}

.contact-hero::after{
    content:'';
    position:absolute;
    width:300px;
    height:300px;
    border-radius:50%;
    background:rgba(255,255,255,.06);
    bottom:-100px;
    left:-100px;
}

.hero-badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:10px 18px;
    border-radius:50px;
    background:rgba(255,255,255,.15);
    backdrop-filter:blur(10px);
    margin-bottom:25px;
}

.contact-hero h1{
    font-size:58px;
    font-weight:800;
    line-height:1.2;
    margin-bottom:25px;
}

.contact-hero h1 span{
    color:#ffe082;
}

.hero-description{
    font-size:18px;
    line-height:1.8;
    margin-bottom:35px;
}

.hero-buttons{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
}

.hero-card{
    background:rgba(255,255,255,.12);
    backdrop-filter:blur(12px);
    border-radius:24px;
    padding:30px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.hero-stat{
    background:rgba(255,255,255,.1);
    border-radius:16px;
    padding:20px;
    text-align:center;
}

.hero-stat h3{
    font-size:32px;
    font-weight:700;
}

.contact-section{
    padding:80px 0;
}

.contact-info,
.contact-form{
    background:#fff;
    border-radius:20px;
    padding:35px;
    box-shadow:0 10px 30px rgba(0,0,0,.08);
    height:100%;
}

.info-item{
    display:flex;
    gap:15px;
    margin-bottom:25px;
}

.info-item i{
    font-size:28px;
    color:#0d6efd;
}

.contact-form .form-control{
    border-radius:12px;
    padding:12px;
}

.contact-form .btn{
    border-radius:12px;
}

.map-section{
    padding-bottom:80px;
}

.map-container{
    overflow:hidden;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,.08);
}

.map-container iframe{
    width:100%;
    height:500px;
    border:none;
}

.working-time{
    background:#f8f9fa;
    padding:80px 0;
}

.time-card{
    background:#fff;
    border-radius:20px;
    padding:35px;
    text-align:center;
    box-shadow:0 10px 25px rgba(0,0,0,.06);
    transition:.3s;
}

.time-card:hover{
    transform:translateY(-8px);
}

.time-card i{
    font-size:42px;
    color:#0d6efd;
    margin-bottom:15px;
}

</style>