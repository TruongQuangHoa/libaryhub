  @await RenderSectionAsync("Meta", required: false)

  @await RenderSectionAsync("Styles", required: false)

  <meta name="description" content="">
  <meta name="keywords" content="">

  <!-- Favicons -->
  <link href="~/assets/img/favicon.png" rel="icon">
  <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>

  <link
  href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap"
  rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
  <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="~/assets/css/main.css" rel="stylesheet">

  <style>
      /* =========================================================
                   CSS CHO PHẦN NGƯỜI DÙNG ĐĂNG NHẬP
                   ========================================================= */

      /* Container chính của Dropdown */
      .user-profile-nav {
        margin-left: 20px;
      }

      /* Nút Toggle */
      .user-profile-nav .user-toggle {
        color: #fff;
        padding: 8px 10px;
        border-radius: 50px;
        transition: background-color 0.3s;
        cursor: pointer;
      }

      .user-profile-nav .user-toggle:hover {
        background-color: rgba(255, 255, 255, 0.15);
      }

      /* Icon mũi tên */
      .user-profile-nav .toggle-icon {
        font-size: 10px;
        margin-left: 5px;
        transition: transform 0.3s;
      }

      /* Dropdown Menu */
      .user-dropdown-menu {
        display: none;
        z-index: 1050;
        top: 100%;
        min-width: 200px;
        padding: 0;
        margin-top: 10px;
        background-color: #fff;
        list-style: none;
      }

      /* Hiển thị Dropdown */
      .user-dropdown-menu.show {
        display: block;
      }

      /* Header Dropdown */
      .user-dropdown-menu .dropdown-header {
        padding: 10px 15px;
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
      }

      .user-dropdown-menu .dropdown-header h6 {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 0;
        color: #333;
      }

      .user-dropdown-menu .dropdown-header span {
        font-size: 14px;
        color: #6c757d;
      }

      /* Các mục Dropdown */
      .user-dropdown-menu li a {
        padding: 10px 15px;
        color: #333;
        text-decoration: none;
        transition: background-color 0.2s;
      }

      .user-dropdown-menu li a:hover {
        background-color: #f1f1f1;
      }

      .user-dropdown-menu .dropdown-divider {
        margin: 5px 0;
        border-top: 1px solid #dee2e6;
      }

      /* =========================================================
                   ADMIN ONLY
                   Các phần có class này sẽ bị ẩn khi đang ở Patron Preview
                   ========================================================= */

      .admin-only {
        transition: none !important;
      }

      body.patron-preview .admin-only {
        display: none !important;
      }

      /* =========================================================
         PATRON PREVIEW
         ========================================================= */

      /* Ẩn tất cả thành phần Admin */
      html[data-patron-preview="true"] .admin-only {
        display: none !important;
      }

      /* Hiện giao diện khách */
      html[data-patron-preview="true"] .patron-guest-only {
        display: flex !important;
      }

      /* Ẩn giao diện tài khoản Patron thật trong Preview */
      html[data-patron-preview="true"] .patron-user-only {
        display: none !important;
      }
  </style>

  <script>
      (function () {

        const url = new URL(window.location.href);

        // Lần đầu Admin mở Patron Preview
        if (url.searchParams.get("clear_cache") === "1") {

          sessionStorage.setItem(
            "PatronPreview",
            "true"
          );

          // Xóa query khỏi URL
          window.history.replaceState(
            {},
            document.title,
            url.pathname + url.hash
          );
        }

        // Kiểm tra trạng thái Preview của tab hiện tại
        if (sessionStorage.getItem("PatronPreview") === "true") {

          document.documentElement.setAttribute(
            "data-patron-preview",
            "true"
          );
        }

      })();
  </script>

</head>

<body class="index-page">

