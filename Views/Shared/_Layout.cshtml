         ========================================================= -->

  <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

  <script src="~/assets/vendor/php-email-form/validate.js"></script>

  <script src="~/assets/vendor/aos/aos.js"></script>

  <script src="~/assets/vendor/purecounter/purecounter_vanilla.js"></script>

  <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>


  <!-- Main JS -->
  <script src="~/assets/js/main.js"></script>

  <!-- jQuery -->
  <script src="~/lib/jquery/dist/jquery.min.js"></script>


  <!-- =========================================================
         PATRON PREVIEW MODE
         ========================================================= -->

  <script>

      (function () {

        /*
        * =====================================================
        * KIỂM TRA URL
        * =====================================================
        *
        * Admin mở:
        *
        * /?clear_cache=1
        *
        * thì chuyển tab này sang Patron Preview.
        */

        const currentUrl = new URL(window.location.href);

        const clearCache =
          currentUrl.searchParams.get("clear_cache");


        /*
        * =====================================================
        * NẾU CÓ clear_cache=1
        * =====================================================
        */

        if (clearCache === "1") {

          /*
          * Lưu trạng thái vào sessionStorage.
          *
          * sessionStorage chỉ tồn tại trong TAB hiện tại.
          *
          * Vì vậy:
          *
          * TAB ADMIN
          *     ↓
          * không bị ảnh hưởng
          *
          * TAB PATRON
          *     ↓
          * PatronPreview = true
          */

          sessionStorage.setItem(
            "PatronPreview",
            "true"
          );


          /*
          * Xóa ?clear_cache=1 khỏi URL.
          *
          * Ví dụ:
          *
          * /?clear_cache=1
          *
          * thành:
          *
          * /
          *
          * Không reload trang.
          */

          const cleanUrl =
            currentUrl.pathname +
            currentUrl.hash;

          window.history.replaceState(
            {},
            document.title,
            cleanUrl
          );
        }


        /*
        * =====================================================
        * KIỂM TRA PATRON PREVIEW
        * =====================================================
        */

        const isPatronPreview =
          sessionStorage.getItem("PatronPreview") === "true";


        /*
        * =====================================================
        * THÊM CLASS VÀO BODY
        * =====================================================
        *
        * Nếu là Patron Preview:
        *
        * <body class="index-page patron-preview">
        *
        * CSS sẽ tự động ẩn .admin-only
        */

        if (isPatronPreview) {

          document.body.classList.add(
            "patron-preview"
          );

        }

      })();

  </script>

  <script>
      document.addEventListener("DOMContentLoaded", function () {

        const isPatronPreview =
          sessionStorage.getItem("PatronPreview") === "true";

        if (!isPatronPreview) {
          return;
        }


        // ==============================================
        // ẨN TOÀN BỘ KHU VỰC ADMIN
        // ==============================================

        document
          .querySelectorAll(".admin-only")
          .forEach(function (element) {

            element.style.display = "none";

          });


        // ==============================================
        // ẨN TÀI KHOẢN PATRON THẬT
        // ==============================================

        document
          .querySelectorAll(".patron-user-only")
          .forEach(function (element) {

            element.style.display = "none";

          });


        // ==============================================
        // HIỆN LOGIN / REGISTER
        // ==============================================

        const guestActions =
          document.getElementById(
            "patron-guest-actions"
          );

        if (guestActions) {

          guestActions.style.display = "flex";

        }

      });
  </script>


  <!-- =========================================================
         RENDER SECTION
         ========================================================= -->

  @RenderSection("Scripts", required: false)

  @await Html.PartialAsync("_ChatWidget")

<link rel="stylesheet"
