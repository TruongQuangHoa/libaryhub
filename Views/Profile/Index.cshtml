@model LibraryHub.Models.ViewModels.ProfileViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-3 border-end">
            <div class="d-flex flex-column align-items-center text-center p-3">
                <div class="position-relative">
                    <img class="rounded-circle" width="150px" src="~/images/avatar-default.png" style="border: 2px solid #00bcd4;">
                </div>
                <span class="font-weight-bold mt-2">@Model.Patron.PatronName</span>
                <span class="text-black-50">@Model.Patron.Email</span>
            </div>
            
            <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                <button class="nav-link active text-start" id="info-tab" data-bs-toggle="pill" data-bs-target="#info" type="button">
                    <i class="bi bi-person-fill"></i> Thông tin cá nhân
                </button>
                <button class="nav-link text-start" id="password-tab" data-bs-toggle="pill" data-bs-target="#password" type="button">
                    <i class="bi bi-shield-lock-fill"></i> Đổi mật khẩu
                </button>
                <button class="nav-link text-start" id="history-tab" data-bs-toggle="pill" data-bs-target="#history" type="button">
                    <i class="bi bi-clock-history"></i> Lịch sử hoạt động
                </button>
            </div>
        </div>

        <div class="col-md-9">
            <div class="tab-content p-3" id="v-pills-tabContent">
                
                <div class="tab-pane fade show active" id="info" role="tabpanel">
                    <h4 class="mb-4">Thông tin cá nhân</h4>
                    <form asp-action="UpdateProfile" method="post">
                        <div class="row mt-2">
                            <div class="col-md-12 mb-3">
                                <label class="labels">Họ và tên</label>
                                <input type="text" class="form-control" asp-for="Patron.PatronName">
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="labels">Email</label>
                                <input type="text" class="form-control" asp-for="Patron.Email" readonly>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="labels">Số điện thoại</label>
                                <input type="text" class="form-control" asp-for="Patron.Phone">
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="labels">Địa chỉ</label>
                                <input type="text" class="form-control" asp-for="Patron.Address">
                            </div>
                        </div>
                        <div class="mt-4">
                            <button class="btn btn-info text-white" type="submit">Lưu thay đổi</button>
                        </div>
                    </form>
                </div>

                <div class="tab-pane fade" id="password" role="tabpanel">
                    <h4 class="mb-4">Đổi mật khẩu</h4>
                    <form asp-action="ChangePassword" method="post">
                        <div class="mb-3">
                            <label class="labels">Mật khẩu hiện tại</label>
                            <input type="password" class="form-control" asp-for="CurrentPassword">
                        </div>
                        <div class="mb-3">
                            <label class="labels">Mật khẩu mới</label>
                            <input type="password" class="form-control" asp-for="NewPassword">
                        </div>
                        <div class="mb-3">
                            <label class="labels">Xác nhận mật khẩu mới</label>
                            <input type="password" class="form-control" asp-for="ConfirmPassword">
                        </div>
                        <button class="btn btn-info text-white" type="submit">Cập nhật mật khẩu</button>
                    </form>
                </div>

                <div class="tab-pane fade" id="history" role="tabpanel">
                    <h4 class="mb-4">Lịch sử mượn sách</h4>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã mượn</th>
                                    <th>Ngày mượn</th>
                                    <th>Hạn trả</th>
                                    <th>Trạng thái</th>
                                    <th>Phí mượn</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.BorrowingHistory)
                                {
                                    <tr>
                                        <td>#@item.BorrowingID</td>
                                        <td>@item.BorrowDate?.ToString("dd/MM/yyyy")</td>
                                        <td>@item.DueDate?.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (item.BorrowingStatusDisplay == "Quá hạn") {
                                                <span class="badge bg-danger">@item.BorrowingStatusDisplay</span>
                                            } else if (item.BorrowingStatusDisplay == "Đã trả") {
                                                <span class="badge bg-success">@item.BorrowingStatusDisplay</span>
                                            } else {
                                                <span class="badge bg-primary">@item.BorrowingStatusDisplay</span>
                                            }
                                        </td>
                                        <td>@item.TotalBorrowingFee.ToString("N0") VNĐ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .nav-pills .nav-link { color: #333; margin-bottom: 5px; }
    .nav-pills .nav-link.active { background-color: #e0f7fa; color: #00838f; border-left: 4px solid #00bcd4; font-weight: bold; }
    .labels { font-size: 14px; font-weight: 500; margin-bottom: 5px; }
    .btn-info { background-color: #00bcd4; border: none; }
</style>