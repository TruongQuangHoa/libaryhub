@model LibraryHub.Models.viewBook

@{
    ViewData["Title"] = "Chi tiết sách và Đăng ký mượn";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string defaultBorrowDate = DateTime.Today.ToString("yyyy-MM-dd");
    string defaultDueDate = DateTime.Today.AddDays(14).ToString("yyyy-MM-dd");
}

<main id="main" class="main mt-5">
    <div class="container">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <h1 class="mb-4">Thông tin sách & Đăng ký mượn</h1>
        <hr>

        <div class="row">
            <!-- Thông tin sách (giữ nguyên) -->
            <div class="col-lg-6">
                <div class="card shadow-sm p-4 mb-4">
                    <h2 class="card-title text-primary">@Html.DisplayFor(model => model.TitleBook)</h2>
                    <h5 class="text-secondary">Thể loại: @(Model.CategoryID != null ? Model.CategoryName : "")</h5>
                    <hr>
                    <dl class="row">
                        <dt class="col-sm-4">Tác giả:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Author)</dd>
                        <dt class="col-sm-4">Nhà xuất bản:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Publisher)</dd>
                        <dt class="col-sm-4">Năm xuất bản:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.PublicationYear)</dd>
                        <dt class="col-sm-4">Số lượng còn lại:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success">@((Model.BookQuantity - Model.BorrowQuantity) > 0 ?
                                                                                                (Model.BookQuantity - Model.BorrowQuantity) : 0) cuốn</span>
                            </dd>
                        </dl>
                        <h4>Tóm tắt nội dung</h4>
                        <p class="text-muted">@Html.DisplayFor(model => model.Description)</p>
                    </div>
                </div>

                <!-- Form đăng ký mượn - Thêm vào giỏ -->
                <div class="col-lg-6">
                    <div class="card shadow-lg p-4 bg-light">
                        <h3 class="text-danger mb-4">Đăng ký mượn sách</h3>

                        @if (User.Identity?.IsAuthenticated == true &&
         User.IsInRole("Patron"))
                        {
                            <form asp-controller="BorrowingCart" asp-action="AddToCart" method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="bookId" value="@Model.BookID" />

                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                                <div class="d-grid">

                                    <button type="submit" class="btn btn-success btn-lg">

                                        <i class="bi bi-cart-plus"></i>
                                        Thêm vào phiếu mượn

                                    </button>

                                </div>

                            </form>
                        }
                        else
                        {
                            <div class="alert alert-warning text-center">

                                <h5>
                                    Bạn cần đăng nhập để mượn sách
                                </h5>

                                <a href="/Login" class="btn btn-primary mt-2">

                                    Đăng nhập ngay

                                </a>

                            </div>
                        }

                        <div class="mt-4 text-center">
                            <a href="/" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại trang chủ
                            </a>
                            <a asp-controller="BorrowingCart" asp-action="Cart" class="btn btn-outline-primary">
                                Xem phiếu mượn hiện tại
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>