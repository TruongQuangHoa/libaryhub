@{
ViewData["Title"] = "Giới thiệu";
}

<!-- HERO -->

<section class="about-hero">
    <div class="container">

    <div class="row align-items-center g-5">

        <div class="col-lg-6">

            <span class="hero-badge">
                📚 Thư viện số hiện đại
            </span>

            <h1>
                Khám phá kho tri thức cùng
                <span>LibraryHub</span>
            </h1>

            <p>
                Nền tảng thư viện trực tuyến giúp bạn dễ dàng tìm kiếm,
                tra cứu và đăng ký mượn sách mọi lúc mọi nơi.
            </p>

            <div class="hero-buttons">
                <a href="/Books" class="btn btn-primary btn-lg">
                    <i class="bi bi-book"></i>
                    Khám phá sách
                </a>

                <a href="/Contact" class="btn btn-outline-primary btn-lg">
                    Liên hệ
                </a>
            </div>

        </div>

        <div class="col-lg-6 text-center">

            <img src="~/assets/img/slide_introduction.jpg"
                 class="img-fluid hero-image"
                 alt="LibraryHub">

        </div>

    </div>

</div>

</section>

<!-- GIỚI THIỆU -->

<section class="about-section">


<div class="container">

    <div class="row align-items-center g-5">

        <div class="col-lg-6">

            <img src="~/assets/img/slide_content_introduction.jpg"
                 class="img-fluid rounded-4 shadow"
                 alt="LibraryHub">

        </div>

        <div class="col-lg-6">

            <h2 class="section-title">
                LibraryHub là gì?
            </h2>

            <p>
                LibraryHub là hệ thống quản lý thư viện trực tuyến
                được xây dựng nhằm hỗ trợ người dùng tìm kiếm,
                tra cứu và đăng ký mượn sách nhanh chóng.
            </p>

            <p>
                Hệ thống cung cấp hàng nghìn đầu sách thuộc nhiều lĩnh vực
                như công nghệ thông tin, giáo dục, kinh tế,
                khoa học, văn học và kỹ năng sống.
            </p>

            <ul class="feature-list">
                <li><i class="bi bi-check-circle-fill"></i> Tìm kiếm sách nhanh chóng</li>
                <li><i class="bi bi-check-circle-fill"></i> Mượn sách trực tuyến tiện lợi</li>
                <li><i class="bi bi-check-circle-fill"></i> Quản lý lịch sử mượn trả</li>
                <li><i class="bi bi-check-circle-fill"></i> Hỗ trợ đa dạng danh mục sách</li>
            </ul>

        </div>

    </div>

</div>

</section>

<!-- THỐNG KÊ -->

<section class="stats-section">

<div class="container">

    <div class="text-center mb-5">

        <span class="section-badge">
            Thành tựu nổi bật
        </span>

        <h2 class="section-title">
            LibraryHub trong những con số
        </h2>

    </div>

    <div class="row g-4">

        <div class="col-md-3">
            <div class="stat-card">
                <h2>5000+</h2>
                <p>Đầu sách</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <h2>2000+</h2>
                <p>Độc giả</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <h2>10000+</h2>
                <p>Lượt mượn</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <h2>20+</h2>
                <p>Danh mục</p>
            </div>
        </div>

    </div>

</div>


</section>

<!-- SỨ MỆNH -->

<section class="mission-section">


<div class="container">

    <div class="text-center mb-5">

        <span class="section-badge">
            Định hướng phát triển
        </span>

        <h2 class="section-title">
            Sứ mệnh & Tầm nhìn
        </h2>

    </div>

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="info-card">

                <div class="icon-box bg-primary">
                    <i class="bi bi-bullseye"></i>
                </div>

                <h4>Sứ mệnh</h4>

                <p>
                    Mang tri thức đến gần hơn với cộng đồng thông qua
                    nền tảng thư viện số hiện đại và thân thiện.
                </p>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="info-card">

                <div class="icon-box bg-success">
                    <i class="bi bi-eye"></i>
                </div>

                <h4>Tầm nhìn</h4>

                <p>
                    Trở thành hệ thống thư viện điện tử hàng đầu
                    phục vụ học tập và nghiên cứu.
                </p>

            </div>

        </div>

    </div>

</div>


</section>

<!-- TÍNH NĂNG -->

<section class="features-section">


<div class="container">

    <div class="text-center mb-5">

        <span class="section-badge">
            Dịch vụ nổi bật
        </span>

        <h2 class="section-title">
            Tính năng nổi bật
        </h2>

    </div>

    <div class="row g-4">

        <div class="col-lg-4">
            <div class="feature-card">
                <i class="bi bi-search"></i>
                <h5>Tìm kiếm sách</h5>
                <p>Tìm kiếm nhanh theo tên sách, tác giả hoặc danh mục.</p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="feature-card">
                <i class="bi bi-journal-bookmark"></i>
                <h5>Mượn sách trực tuyến</h5>
                <p>Đăng ký mượn sách mọi lúc mọi nơi.</p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="feature-card">
                <i class="bi bi-clock-history"></i>
                <h5>Lịch sử mượn trả</h5>
                <p>Theo dõi toàn bộ quá trình mượn và trả sách.</p>
            </div>
        </div>

    </div>

</div>


</section>

<!-- CTA -->

<section class="cta-section">


<div class="container text-center">

    <h2>
        Sẵn sàng khám phá kho tri thức?
    </h2>

    <p>
        Hàng nghìn đầu sách đang chờ bạn tìm đọc tại LibraryHub.
    </p>

    <a href="/Books" class="btn btn-light btn-lg">
        <i class="bi bi-book"></i>
        Xem danh mục sách
    </a>

</div>

</section>

<style>

.about-hero{
    background:linear-gradient(
        135deg,
        #eff6ff 0%,
        #ffffff 50%,
        #dbeafe 100%
    );
    padding:120px 0;
}

.hero-badge{
    display:inline-block;
    padding:10px 20px;
    background:#dbeafe;
    color:#2563eb;
    border-radius:30px;
    font-weight:600;
    margin-bottom:20px;
}

.about-hero h1{
    font-size:60px;
    font-weight:800;
    color:#1e293b;
}

.about-hero h1 span{
    color:#2563eb;
}

.about-hero p{
    font-size:20px;
    color:#64748b;
    margin:25px 0;
}

.hero-image{
    border-radius:30px;
    box-shadow:0 20px 40px rgba(37,99,235,.15);
}

.section-badge{
    display:inline-block;
    padding:8px 18px;
    background:#e0f2fe;
    color:#0284c7;
    border-radius:30px;
    font-weight:600;
}

.section-title{
    font-size:40px;
    font-weight:700;
    margin-top:15px;
    margin-bottom:25px;
}

.about-section,
.mission-section,
.features-section{
    padding:100px 0;
}

.stats-section{
    background:#f8fafc;
    padding:100px 0;
}

.stat-card,
.info-card,
.feature-card{
    background:#fff;
    border-radius:24px;
    padding:35px;
    text-align:center;
    box-shadow:0 10px 25px rgba(0,0,0,.06);
    transition:.3s;
    height:100%;
}

.stat-card:hover,
.info-card:hover,
.feature-card:hover{
    transform:translateY(-8px);
}

.stat-card h2{
    color:#2563eb;
    font-size:48px;
    font-weight:800;
}

.icon-box{
    width:80px;
    height:80px;
    border-radius:50%;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:32px;
    margin:auto auto 20px;
}

.feature-card i{
    font-size:48px;
    color:#2563eb;
    margin-bottom:20px;
}

.feature-list{
    list-style:none;
    padding:0;
}

.feature-list li{
    margin-bottom:12px;
}

.feature-list i{
    color:#16a34a;
    margin-right:10px;
}

.cta-section{
    background:linear-gradient(
        135deg,
        #2563eb,
        #60a5fa
    );
    color:#fff;
    padding:100px 0;
}

.cta-section h2{
    font-size:42px;
    font-weight:700;
}

.cta-section p{
    font-size:18px;
    margin:20px 0 30px;
}

</style>
